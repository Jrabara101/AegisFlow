module Setup where

import Daml.Script
import DA.Time (days, addRelTime)
import AegisFlow.Factoring

-- | End-to-end demo: seller tokenizes an invoice, proposes financing to a
-- lender-only view, the lender accepts, the seller draws down the advance,
-- an agentic milestone update fires, and the funding is settled. Run with:
--   daml script --dar .daml/dist/aegisflow-0.1.0.dar --script-name Setup:setup --ledger-host localhost --ledger-port 6865
setup : Script ()
setup = do
  seller <- allocateParty "Seller"
  lender <- allocateParty "Lender"
  outsider <- allocateParty "Outsider"

  now <- getTime
  let due = addRelTime now (days 60)

  -- 1. Seller records the private commercial details and tokenizes the
  --    invoice. Only `seller` can see either contract.
  detailsCid <- submit seller do
    createCmd InvoiceDetails with
      seller
      invoiceId = "INV-2026-0091"
      buyerRef = "BUYER-REF-88213"
      lineItems = ["200x industrial valves", "Freight and insurance"]

  invoiceCid <- submit seller do
    createCmd InvoiceAsset with
      seller
      invoiceId = "INV-2026-0091"
      faceValue = 100000.0
      dueDate = due
      milestone = Shipped
      financed = False

  -- 2. Seller proposes financing to exactly one lender at a 90% advance rate.
  proposalCid <- submit seller do
    exerciseCmd invoiceCid InvoiceAsset_ProposeFinancing with
      lender
      advanceRate = 0.90

  -- 3. `outsider` has no visibility into either contract — privacy check.
  outsiderView <- queryContractId @FundingProposal outsider proposalCid
  assertMsg "outsider must not see the funding proposal" (outsiderView == None)

  -- 4. Lender accepts, creating the bilateral FundingAgreement.
  agreementCid <- submit lender do
    exerciseCmd proposalCid FundingProposal_Accept

  -- 5. Atomic disbursement: invoice flips to `financed = True` in the same
  --    transaction the advance is released.
  (agreementCid2, invoiceCid2) <- submit seller do
    exerciseCmd agreementCid FundingAgreement_Disburse

  -- 6. Agentic trigger: seller's backend reports a Delivered milestone from
  --    the logistics API, releasing the held tranche per the agreed terms.
  _ <- submit seller do
    exerciseCmd invoiceCid2 InvoiceAsset_UpdateMilestone with
      newMilestone = Delivered

  submit seller do
    exerciseCmd agreementCid2 FundingAgreement_ReleaseOnMilestone with
      observedMilestone = Delivered

  -- 7. Final settlement at due date, requires both signatures.
  submitMulti [seller, lender] [] do
    exerciseCmd agreementCid2 FundingAgreement_Settle

  -- 8. Privacy check: after the full lifecycle, the lender and outsider
  --    still cannot see the buyer identity or line items.
  lenderDetails <- queryContractId @InvoiceDetails lender detailsCid
  assertMsg "lender must not see invoice details" (lenderDetails == None)
  outsiderDetails <- queryContractId @InvoiceDetails outsider detailsCid
  assertMsg "outsider must not see invoice details" (outsiderDetails == None)

  pure ()
